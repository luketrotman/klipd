# Copy to .env.local for local development, or set as secrets on the host. Never commit real values.

# --- Required in production
APP_URL=https://klipd.example.com          # public URL, used in sign-in emails and share links
AUTH_SECRET=                               # 32+ random chars: openssl rand -base64 32
ADMIN_EMAILS=you@example.com               # comma separated; these emails become admins on sign-in
DATA_DIR=/data                             # persistent volume: database, detections, rendered clips

# --- Sign-in email (Resend). Without it, production sign-in is impossible and dev shows the link on screen
RESEND_API_KEY=
EMAIL_FROM="KLIPD <hello@yourdomain.com>"

# --- Push notifications: npm run vapid  (prints a fresh pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Processing worker (ai/worker.py on a Mac or GPU box)
WORKER_TOKEN=                              # 16+ random chars; the same value goes on the worker machine
PROCESSING_MODE=worker                     # web server queues jobs; local = run everything on this machine

# --- Optional
SEED_MODE=empty                            # empty | demo (production defaults to empty, development to demo)
DEMO_LOGIN=0                               # 1 shows the demo player picker (never in production)
MEDIA_BASE_URL=                            # set if clips are served from a CDN
